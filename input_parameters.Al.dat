Nchar 2
Nel 1500
ipOut 1500
Nregion 1

simulation_type impact

B0 9.d-12 8.d-12   ! MPa-s
C11 106750.0  ! MPa
C12 60410.0
C44 28340.0
! values for CP, CT are from Thomas 1968:
CP11 6.35
CP12 3.45
CP44 2.10
CT11 -35.1  ! MPa / K
CT12 -6.7
CT44 -14.5
specific_heat 897.d6 ! mJ / Mg -K
L0 0.5  ! mm
bulk_c1 0.20d0 # bulk viscosity, coeff. of linear term
bulk_c2 1.20d0 # bulk viscosity, coeff. of quadratic term
burger 3d-07     ! mm
c1 0.5
cdt_A 2.0   ! dislocation annihilation factor
cdt_Aint -0.1 ! bump up from 0.1 to be closer to the average value of the generalized source term
! change to cdt_Aint -0.4 (or any other negative value) to trigger the use of the generalized source term
cdt_K 30.0   ! dislocation multiplication factor M = 1./cdt_K
cdt_Y_e 1.8d-06  ! [mm] =6*burger
cdt_rhoDot_n0 1.d13  ! set 0 to turn off nucleation (next 4 params are for nucleation)
cdt_G_n0 0.84564d-16   ! [mJ] = 0.12d0*mu*burger**3 with mu=26100MPa=average shear mod.
cdt_pn 1.0
cdt_qn 1.0
cdt_tau_n0 115.0
g0 0.65    # Austin,McDowell 2012
impact_angle 0.0
impact_velocity 300000.0
mu 0
omega0 8.0d11
p 0.33
! for psi0:
! code version >=20200512 will fall back to this:
! eos_v_star 370d6  # take rho0 as reference point, i.e. vstar=1/rho0
! eos_B1 4.42 # calculated from (CP11+2CP12)/3 above for ref. point ambient volume at room temp. rho0
! eos_B_star 75.86d3 # calculted from (C11+2C12)/3 above at rho0

! code version >=20200512 will fall back to zero for psi_ion and psi_electron
! for psi-ion:
eos_R_M 308.154d6 # gas constant over molar mass R/m_atom = 8.3144598/26.9815386 (x 1e9 in present units), CRC values
eos_Td0 428.0 # Debye temperature at ref. volume eos_rho0, cf. Phillips, Phys. Rev. 114 (1959) 676
eos_a -0.95 # from Burakovsky & Preston 2004 model, re-fitted to present fctl. form in range rho/rho_0 in [0.95,1.3]
eos_b 2.78
! eos_gamma 0.6666666666666666 # = default value in code
! for psi-electron:
! eos_Gamma0 50000.d0 ! taken from JETP 11no3 (1960) 573, http://jetp.ac.ru/cgi-bin/dn/e_011_03_0573.pdf
! eos_kappa 0.5d0 ! taken from JETP 11no3 (1960) 573, http://jetp.ac.ru/cgi-bin/dn/e_011_03_0573.pdf
! eos_rho0 2.71d-09 ! ref. density for Gamma0
! maybe better:
eos_Gamma0 50034.d0 ! =1.35/26.9815386*1e6 taken from Phys Chem Minerals (2010) 37:721, DOI 10.1007/s00269-010-0371-6
eos_kappa 0.6666666666666666 ! =2/3 taken from Phys Chem Minerals (2010) 37:721, DOI 10.1007/s00269-010-0371-6
eos_rho0 2.7d-09 ! initial density for eos calcs, code falls back to rhobar0 if omitted
eos_v0 366300366.3 ! 1/(ref. density=2.73d-9)  (at T=0K from Burakovsky, Greeff & Preston 2003), used for psi_ion & psi_e
q 1.66
rho0 3.0d6 ! mm^-2
rhobar0 2.7d-09   ! (Mg / mm^3)
t_stop 2d-07
t_vel 2.4d-06
dt0 2.0d-11 ! s
dt_output 5.0d-10  ! s
tau0 20.0
temperature0 300.0  ! K
drag_flag iso
drag_Trho_flag .True.
backstress_model gradient
wave_vel 3126.d3 2929.d3  ! mm/s
echoinput .True.
debug_cycle -1 ! not an actual cycle but triggers some additional printout
CDTintFlux zero
